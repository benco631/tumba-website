# Copy to .env.local (gitignored) for local development. Both variables are
# public/build-time (Next.js inlines any NEXT_PUBLIC_ variable into the
# client bundle), so never put secrets in either one.

# Base URL of the backend waitlist API, no trailing slash. The frontend
# posts to `${NEXT_PUBLIC_API_BASE_URL}/waitlist`.
NEXT_PUBLIC_API_BASE_URL=https://api.tumbaapp.com

# Must match the privacy-policy version the backend expects on submissions.
NEXT_PUBLIC_PRIVACY_POLICY_VERSION=1.0

# ---------------------------------------------------------------------------
# The static website/ implementation is plain HTML/JS (no Next.js build
# step), so it cannot read process.env. It reads the same two values from the
# "apiBaseUrl" / "privacyPolicyVersion" entries in its own
# <script type="text/x-dc" data-props="..."> block instead — set them there
# when that page is exported/deployed by its site-builder tool.
